<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BuddyUp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.BuddyUp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.BuddyUp</item>
    </style>
</resources>
