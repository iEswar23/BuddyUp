    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_title_1">New city? New hobby?\nMake a buddy.</string>
    <string name="onboarding_body_1">BuddyUp connects you with friendly people nearby who love the same things you do. No swiping for dates — just good company.</string>
    <string name="onboarding_title_2">Wave hello,\nno pressure</string>
    <string name="onboarding_body_2">Send a wave to anyone who looks fun to hang out with. When they wave back, you\'re buddies and can start chatting.</string>
    <string name="onboarding_title_3">Show up for\nlocal meetups</string>
    <string name="onboarding_body_3">Coffee walks, board-game nights and weekend hikes hosted by people in your city. Join with one tap.</string>

